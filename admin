// =============================================================
// Order ⇄ Invoice linking
// -------------------------------------------------------------
// Once an order turns into an invoice (order.invoiceId / invoice.orderId),
// they're treated as one record with two views. Status, payment link, and
// delivery link move together in both directions so whichever side you're
// editing, the other one is never left stale.
// =============================================================
const ORDER_TO_INVOICE_STATUS = { in_progress: 'pending', completed: 'finished' };
const INVOICE_TO_ORDER_STATUS = { pending: 'in_progress', finished: 'completed' };

// Push a partial update from an order onto its linked invoice (no-op if not linked yet)
function syncOrderToInvoice(o, patch) {
    if (!o || !o.invoiceId) return Promise.resolve();
    const invPatch = {};
    if ('status' in patch && ORDER_TO_INVOICE_STATUS[patch.status]) invPatch.status = ORDER_TO_INVOICE_STATUS[patch.status];
    if ('paid' in patch) invPatch.paid = patch.paid;
    if ('deliveredFileUrl' in patch) invPatch.deliveredFileUrl = patch.deliveredFileUrl;
    if ('paymentLink' in patch) invPatch.paymentLink = patch.paymentLink;
    if ('payment' in patch) invPatch.payment = patch.payment;
    if (!Object.keys(invPatch).length) return Promise.resolve();
    return db.collection('invoices').doc(o.invoiceId).update(invPatch);
}

// Push a partial update from an invoice onto its source order (no-op if not linked)
function syncInvoiceToOrder(inv, patch) {
    if (!inv || !inv.orderId) return Promise.resolve();
    const ordPatch = {};
    if ('status' in patch && INVOICE_TO_ORDER_STATUS[patch.status]) ordPatch.status = INVOICE_TO_ORDER_STATUS[patch.status];
    if ('paid' in patch) ordPatch.paid = patch.paid;
    if ('deliveredFileUrl' in patch) ordPatch.deliveredFileUrl = patch.deliveredFileUrl;
    if ('paymentLink' in patch) ordPatch.paymentLink = patch.paymentLink;
    if (!Object.keys(ordPatch).length) return Promise.resolve();
    return db.collection('orders').doc(inv.orderId).update(ordPatch);
}

// Manually cross-link an order and an invoice that exist but were never connected
// (e.g. the order's status was set by hand instead of via "قبول", or the pair
// predates this linking feature). Once linked, the normal sync functions above
// take over automatically for any future change on either side.
function linkOrderAndInvoice(order, inv) {
    return Promise.all([
        db.collection('orders').doc(order.id).update({ invoiceId: inv.id, invoiceNumber: inv.number || '' }),
        db.collection('invoices').doc(inv.id).update({ orderId: order.id, orderNumber: order.number || '' })
    ]).then(() => syncOrderToInvoice({ ...order, invoiceId: inv.id }, {
        status: order.status,
        paid: order.paid || false,
        deliveredFileUrl: order.deliveredFileUrl || '',
        paymentLink: order.paymentLink || '',
        payment: order.payment || ''
    }));
}


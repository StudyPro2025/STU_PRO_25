// Exports the invoice sheet as a PNG image (not PDF). Uses html-to-image, which
// renders through an SVG foreignObject so the browser draws the Arabic text itself —
// this avoids the garbled/reversed text that html2canvas produced with RTL content.
async function downloadInvoiceImage(id) {
    const inv = invoices.find(i => i.id === id);
    const sheet = document.querySelector('#view-invoice-content .doc-sheet');
    if (!inv || !sheet) {
        showToast('تعذر تجهيز الفاتورة، حاول تاني', 'error');
        return;
    }
    if (typeof htmlToImage === 'undefined') {
        showToast('تعذر تحميل مكتبة تصدير الصور، تأكد من الاتصال بالإنترنت وحاول تاني', 'error');
        return;
    }

    // Force light theme while capturing so the exported image looks the same
    // regardless of whether the admin currently has dark mode on.
    const originalTheme = document.documentElement.getAttribute('data-theme');
    document.documentElement.setAttribute('data-theme', 'light');

    // Let the browser repaint with the light-theme styles before we snapshot it.
    await new Promise(resolve => requestAnimationFrame(() => requestAnimationFrame(resolve)));

    try {
        const dataUrl = await htmlToImage.toPng(sheet, {
            backgroundColor: '#ffffff',
            pixelRatio: 2,
            cacheBust: true
        });
        const link = document.createElement('a');
        link.download = `فاتورة-${inv.number || id}.png`;
        link.href = dataUrl;
        document.body.appendChild(link);
        link.click();
        link.remove();
        showToast('تم تحميل الفاتورة كصورة', 'success');
    } catch (err) {
        console.error('downloadInvoiceImage error', err);
        showToast('حدث خطأ أثناء إنشاء الصورة', 'error');
    } finally {
        if (originalTheme) document.documentElement.setAttribute('data-theme', originalTheme);
        else document.documentElement.removeAttribute('data-theme');
    }
}

function deleteInvoice(id) {
    if (!confirm('هل أنت متأكد من حذف هذه الفاتورة؟ هتتنقل لسلة المهملات وتقدر تسترجعها منها.')) return;
    const inv = invoices.find(i => i.id === id);
    if (!inv) { showToast('تعذر العثور على الفاتورة', 'error'); return; }
    const { id: _drop, ...invData } = inv;
    moveToTrash('invoice', id, invData)
        .then(() => db.collection('invoices').doc(id).delete())
        .then(() => {
            // Refund any promo-code budget this invoice had used
            const usage = getPromoUsageMap(inv.items);
            const refundMap = {};
            Object.keys(usage).forEach(code => {
                refundMap[code] = { discount: -usage[code].discount, count: -usage[code].count };
            });
            applyPromoUsageDelta(refundMap);
            showToast('انتقلت الفاتورة لسلة المهملات', 'success');
        })
        .catch(() => showToast('حدث خطأ أثناء الحذف', 'error'));
}

// Build a { CODE: { discount: totalDiscount, count: lineCount } } map from a list of
// invoice/order service items. "count" is how many line items used that code — this is
// what feeds the "استخدم الكود X مرة" counter, separate from the $ budget tracking.
function getPromoUsageMap(items) {
    const map = {};
    (items || []).forEach(it => {
        const code = (it.promo || '').trim().toUpperCase();
        const discount = Number(it.discount) || 0;
        if (!code) return;
        if (!map[code]) map[code] = { discount: 0, count: 0 };
        if (discount > 0) map[code].discount += discount;
        map[code].count += 1;
    });
    return map;
}

// Apply usage deltas (positive = more used, negative = refund) to each promocode's
// remaining budget AND its usedCount (how many times it's been applied).
function applyPromoUsageDelta(deltaMap) {
    const updates = Object.keys(deltaMap)
        .filter(code => deltaMap[code] && (deltaMap[code].discount || deltaMap[code].count))
        .map(code => {
            const promo = promocodes.find(p => (p.code || '').toUpperCase() === code);
            if (!promo) return null;
            const delta = deltaMap[code];
            const updateData = {};

            if (!promo.unlimited) {
                const budget = Number(promo.budget) || 0;
                const currentRemaining = Number(promo.remaining ?? budget);
                updateData.remaining = Math.max(0, Math.min(budget, currentRemaining - (delta.discount || 0)));
            }

            const currentUsedCount = Number(promo.usedCount) || 0;
            updateData.usedCount = Math.max(0, currentUsedCount + (delta.count || 0));

            return db.collection('promocodes').doc(promo.id).update(updateData);
        })
        .filter(Boolean);
    return Promise.all(updates);
}

document.getElementById('invoice-form').addEventListener('submit', (e) => {
    e.preventDefault();
    const id = document.getElementById('invoice-id').value;
    const items = getServiceItems('invoice');
    if (!items.length) { showToast('أضف خدمة واحدة على الأقل', 'error'); return; }
    const subtotal = items.reduce((s, it) => s + it.price * it.qty, 0);
    const discountTotal = items.reduce((s, it) => s + it.discount, 0);
    const total = Math.max(0, subtotal - discountTotal);
    const numberValue = document.getElementById('invoice-number').value.trim();
    const dateValue = document.getElementById('invoice-date').value; // yyyy-mm-dd from <input type="date">
    if (!numberValue) { showToast('من فضلك أدخل رقم الفاتورة', 'error'); return; }
    if (!dateValue) { showToast('من فضلك أدخل تاريخ الفاتورة', 'error'); return; }
    const duplicateInvoice = invoices.find(i => i.id !== id && (i.number || '').trim() === numberValue);
    if (duplicateInvoice) { showToast('رقم الفاتورة ده مستخدم بالفعل في فاتورة تانية (' + duplicateInvoice.name + ')', 'error'); return; }

    // Preserve original time-of-day when editing, otherwise use current time on the chosen date
    const previousCreated = id ? invoices.find(i => i.id === id)?.created : null;
    const timePart = previousCreated ? previousCreated.slice(11) : new Date().toISOString().slice(11);
    const createdValue = `${dateValue}T${timePart}`;

    const data = {
        number: numberValue,
        name: document.getElementById('invoice-name').value.trim(),
        phone: document.getElementById('invoice-phone').value.trim(),
        level: document.getElementById('invoice-level').value.trim(),
        university: document.getElementById('invoice-university').value.trim(),
        items: items,
        subject: items.map(it => it.service).filter(Boolean).join('، '),
        subtotal: subtotal,
        discountTotal: discountTotal,
        email: document.getElementById('invoice-email').value.trim(),
        payment: document.getElementById('invoice-payment').value,
        ref: document.getElementById('invoice-ref').value.trim(),
        amount: total,
        status: document.getElementById('invoice-status').value,
        notes: document.getElementById('invoice-notes').value.trim(),
        deliveredFileUrl: document.getElementById('invoice-delivery-link').value.trim(),
        paymentLink: document.getElementById('invoice-payment-link').value.trim(),
        created: createdValue
    };

    // Compute how promo-code usage changed vs the previous saved version (0 if this is a new invoice)
    const oldItems = id ? (invoices.find(i => i.id === id)?.items || []) : [];
    const oldUsage = getPromoUsageMap(oldItems);
    const newUsage = getPromoUsageMap(items);
    const codes = new Set([...Object.keys(oldUsage), ...Object.keys(newUsage)]);
    const deltaMap = {};
    codes.forEach(code => {
        const o = oldUsage[code] || { discount: 0, count: 0 };
        const n = newUsage[code] || { discount: 0, count: 0 };
        deltaMap[code] = { discount: n.discount - o.discount, count: n.count - o.count };
    });

    const savePromise = id
        ? db.collection('invoices').doc(id).update(data)
        : db.collection('invoices').add(data);

    savePromise
        .then(() => applyPromoUsageDelta(deltaMap))
        .then(() => {
            if (id) {
                const inv = invoices.find(x => x.id === id);
                return syncInvoiceToOrder(inv, {
                    status: data.status,
                    deliveredFileUrl: data.deliveredFileUrl,
                    paymentLink: data.paymentLink
                });
            }
        })
        .then(() => { closeModal('invoice-modal'); showToast(id ? 'تم تحديث الفاتورة' : 'تم إنشاء الفاتورة', 'success'); })
        .catch(() => showToast('حدث خطأ أثناء الحفظ', 'error'));
});


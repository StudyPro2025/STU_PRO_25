            document.getElementById('invoice-university').value = inv.university || '';
            document.getElementById('invoice-email').value = inv.email || '';
            document.getElementById('invoice-payment').value = inv.payment || '';
            document.getElementById('invoice-ref').value = inv.ref || '';
            document.getElementById('invoice-status').value = inv.status || 'new';

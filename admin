function showToast(message, type = 'success') {
    const toast = document.getElementById('toast');
    toast.textContent = (type === 'success' ? '✓ ' : '✕ ') + message;
    toast.className = 'toast toast-' + type + ' show';
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => toast.classList.remove('show'), 3000);
}

// =============================================================
// Export — Excel (.xlsx via SheetJS) & PDF (via the browser's print dialog,
// same "print to PDF" approach already used for invoices)
// =============================================================
function itemsSummary(items) {
    if (!Array.isArray(items) || !items.length) return '';
    return items.map(it => {
        let s = `${it.service || ''} (${it.qty || 1}× $${Number(it.price || 0).toLocaleString()})`;
        if (it.discount) s += ` خصم $${Number(it.discount).toLocaleString()}`;
        if (it.promo) s += ` [${it.promo}]`;
        return s;
    }).join(' | ');
}

function exportRowsToExcel(rows, filename, sheetName) {
    if (typeof XLSX === 'undefined') { showToast('تعذر تحميل مكتبة Excel، تأكد من اتصالك بالإنترنت وحاول تاني', 'error'); return; }
    if (!rows.length) { showToast('مفيش بيانات تتصدّر', 'error'); return; }
    const ws = XLSX.utils.json_to_sheet(rows);
    const wb = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(wb, ws, sheetName);
    XLSX.writeFile(wb, filename);
}

function exportRowsToPDF(title, rows) {
    if (!rows.length) { showToast('مفيش بيانات تتصدّر', 'error'); return; }
    const printWindow = window.open('', '_blank', 'width=1400,height=900');
    if (!printWindow) { showToast('يرجى السماح بالنوافذ المنبثقة (pop-ups) للتصدير', 'error'); return; }

    const headers = Object.keys(rows[0]);
    const theadHtml = '<tr>' + headers.map(h => `<th>${escapeHtml(h)}</th>`).join('') + '</tr>';
    const tbodyHtml = rows.map(r => '<tr>' + headers.map(h => `<td>${escapeHtml(r[h])}</td>`).join('') + '</tr>').join('');

    printWindow.document.write(`<!DOCTYPE html>
<html lang="ar" dir="rtl"><head><meta charset="UTF-8">
<title>${escapeHtml(title)}</title>
<style>
@page { size: A4 landscape; margin: 10mm; }
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap');
* { margin:0; padding:0; box-sizing:border-box; }
body { font-family:'Cairo',sans-serif; direction:rtl; padding:16px; color:#101828; }
h1 { font-size:18px; margin-bottom:4px; }
.meta { font-size:11px; color:#66738a; margin-bottom:12px; }
table { width:100%; border-collapse:collapse; font-size:10px; table-layout:auto; }
th, td { border:1px solid #ccd3e0; padding:5px 6px; text-align:right; vertical-align:top;
         white-space:normal; word-break:normal; overflow-wrap:break-word; line-height:1.5; }
th { background:#16233d; color:#fff; font-weight:700; }
tr { page-break-inside: avoid; }
tr:nth-child(even) td { background:#f4f6f9; }
@media print { body { padding:0; } th { background:#16233d !important; -webkit-print-color-adjust:exact; print-color-adjust:exact; } }
</style></head>
<body>
<h1>${escapeHtml(title)}</h1>
<div class="meta">تاريخ التصدير: ${new Date().toLocaleString('ar-EG')} — إجمالي ${rows.length} سجل</div>
<table><thead>${theadHtml}</thead><tbody>${tbodyHtml}</tbody></table>
</body></html>`);
    printWindow.document.close();

    const triggerPrint = () => { printWindow.focus(); printWindow.print(); };
    if (printWindow.document.fonts && printWindow.document.fonts.ready) {
        printWindow.document.fonts.ready.then(triggerPrint).catch(() => setTimeout(triggerPrint, 500));
    } else {
        setTimeout(triggerPrint, 500);
    }
}


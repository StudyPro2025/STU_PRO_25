            --teal-500:#2dd4bf; --teal-600:#14b8a6; --amber-500:#d9a441; --amber-50:#fbf3e2;
            --success:#1a9c72; --success-bg:#e4f7ef; --danger:#d64545; --danger-bg:#fdeaea;
            --info-bg:#e8f1ff; --info:#2563eb; --paper:#f4f6f9; --surface:#ffffff;
            --ink-900:#101828; --ink-700:#344055; --ink-500:#66738a; --ink-400:#93a0b4;
            --border:#e3e7ee; --border-strong:#ccd3e0; --font-display:'Cairo',sans-serif;
            --font-mono:'IBM Plex Mono',monospace;
        }
        * { margin:0; padding:0; box-sizing:border-box; }

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>StudyPro | Business Management System</title>
<script>(function(){try{var p=localStorage.getItem('studypro-theme')||'system';var d=p==='dark'||(p==='system'&&matchMedia('(prefers-color-scheme: dark)').matches);document.documentElement.setAttribute('data-theme',d?'dark':'light');}catch(e){}})();</script>
<style>
/* =========================================================
   StudyPro — Business Management System
   Design tokens
   ========================================================= */
@import url('https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap');

:root {
    /* Color */
    --navy-950: #0c1526;
    --navy-900: #0f1c33;
    --navy-800: #16233d;
    --navy-700: #1d2f4f;
    --navy-600: #2a4066;
    --teal-500: #2dd4bf;
    --teal-600: #14b8a6;
    --teal-50:  #ecfdfb;
    --amber-500:#d9a441;
    --amber-50: #fbf3e2;
    --success:  #1a9c72;
    --success-bg:#e4f7ef;
    --danger:   #d64545;
    --danger-bg:#fdeaea;
    --info-bg:  #e8f1ff;
    --info:     #2563eb;

    --paper:    #f4f6f9;
    --surface:  #ffffff;
    --ink-900:  #101828;
    --ink-700:  #344055;
    --ink-500:  #66738a;
    --ink-400:  #93a0b4;
    --border:   #e3e7ee;
    --border-strong: #ccd3e0;
    --topbar-bg: rgba(244,246,249,0.86);
    --price-ink: var(--navy-800);

    /* Type */
    --font-display: 'Cairo', sans-serif;
    --font-mono: 'IBM Plex Mono', monospace;

    /* Shape */
    --radius-lg: 18px;
    --radius-md: 12px;
    --radius-sm: 8px;
    --shadow-card: 0 1px 2px rgba(16,24,40,0.04), 0 4px 16px rgba(16,24,40,0.06);
    --shadow-pop:  0 12px 40px rgba(16,24,40,0.16);
}

/* =========================================================
   Dark mode overrides
   ========================================================= */
:root[data-theme="dark"] {
    --teal-50:  #0f2c29;
    --amber-50: #2e2510;
    --success-bg:#0f2a20;
    --danger-bg:#3a1a1a;
    --info-bg:  #142238;

    --paper:    #0b111d;
    --surface:  #141c2c;
    --ink-900:  #eef2f8;
    --ink-700:  #c1cadb;
    --ink-500:  #93a0b4;
    --ink-400:  #66738a;
    --border:   #24304a;
    --border-strong: #37455f;
    --topbar-bg: rgba(11,17,29,0.86);
    --price-ink: #eef2f8;

    --shadow-card: 0 1px 2px rgba(0,0,0,0.25), 0 4px 16px rgba(0,0,0,0.3);
    --shadow-pop:  0 12px 40px rgba(0,0,0,0.5);
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
    font-family: var(--font-display);
    background: var(--paper);
    color: var(--ink-900);
    min-height: 100vh;
    -webkit-font-smoothing: antialiased;
    transition: background-color .2s ease, color .2s ease;
}

::selection { background: var(--teal-500); color: white; }

button, input, select, textarea { font-family: inherit; }

:focus-visible {
    outline: 2.5px solid var(--teal-500);
    outline-offset: 2px;
}

/* Reduced motion */
@media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
}

/* =========================================================
   App shell
   ========================================================= */
.app-container { display: flex; min-height: 100vh; }

/* ---------- Sidebar ---------- */
.sidebar {
    width: 264px;
    background: linear-gradient(180deg, var(--navy-900) 0%, var(--navy-950) 100%);
    position: fixed;
    top: 0; right: 0;
    height: 100vh;
    display: flex;
    flex-direction: column;
    z-index: 200;
    transition: transform .25s ease;
}

.brand {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 26px 22px 22px;
    border-bottom: 1px solid rgba(255,255,255,0.08);
}

.brand-mark {
    width: 42px; height: 42px;
    border-radius: 11px;
    background: #ffffff;
    padding: 5px;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
}

.brand-name { font-size: 17px; font-weight: 800; color: #fff; letter-spacing: .3px; }
.brand-sub  { font-size: 10px; font-weight: 600; color: var(--teal-500); letter-spacing: 1.8px; margin-top: 2px; }

.nav-menu { padding: 18px 14px; display: flex; flex-direction: column; gap: 3px; flex: 1; overflow-y: auto; }

.nav-section-label {
    font-size: 10.5px; font-weight: 700; color: rgba(255,255,255,0.32);
    letter-spacing: 1.4px; padding: 14px 12px 6px;
}

.nav-item {
    display: flex; align-items: center; gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-sm);
    color: rgba(255,255,255,0.68);
    text-decoration: none;
    font-size: 14.5px; font-weight: 600;
    cursor: pointer;
    position: relative;
    transition: background .15s ease, color .15s ease;
}

.nav-item .nav-icon { font-size: 17px; width: 20px; text-align: center; opacity: .9; }
.nav-item .nav-count {
    margin-right: auto;
    background: rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.7);
    font-family: var(--font-mono);
    font-size: 11px; font-weight: 600;
    padding: 1px 7px; border-radius: 20px;
}

.nav-item:hover { background: rgba(255,255,255,0.06); color: #fff; }

.nav-item.active {
    background: rgba(45,212,191,0.14);
    color: #fff;
}
.nav-item.active::before {
    content: '';
    position: absolute; right: 0; top: 8px; bottom: 8px; width: 3px;
    background: var(--teal-500); border-radius: 3px 0 0 3px;
}
.nav-item.active .nav-count { background: var(--teal-500); color: var(--navy-950); }

.sidebar-foot {
    padding: 16px 22px 20px;
    border-top: 1px solid rgba(255,255,255,0.08);
    font-size: 11px; color: rgba(255,255,255,0.35);
    display: flex; align-items: center; gap: 8px;
}
.foot-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--success); box-shadow: 0 0 0 3px rgba(26,156,114,0.25); }

/* ---------- Main ---------- */
.main-content { flex: 1; margin-right: 264px; min-height: 100vh; display: flex; flex-direction: column; }

.topbar {
    position: sticky; top: 0; z-index: 100;
    background: var(--topbar-bg);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    padding: 16px 32px;
    display: flex; align-items: center; gap: 18px;
}

.menu-toggle {
    display: none;
    width: 38px; height: 38px; border-radius: var(--radius-sm);
    border: 1px solid var(--border); background: var(--surface);
    font-size: 17px; cursor: pointer;
}

.search-box { position: relative; flex: 1; max-width: 380px; }
.search-box input {
    width: 100%;
    padding: 10px 40px 10px 14px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 13.5px;
    color: var(--ink-900);
}
.search-box input:focus { border-color: var(--teal-500); outline: none; }
.search-box .search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--ink-400); font-size: 14px; }

.search-dropdown {
    position: absolute; top: calc(100% + 8px); left: 0; width: 100%;
    background: var(--surface); border-radius: var(--radius-md);
    box-shadow: var(--shadow-pop); border: 1px solid var(--border);
    max-height: 360px; overflow-y: auto; display: none; z-index: 500;
}
.search-dropdown.show { display: block; }
.search-item {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px 14px; cursor: pointer; border-bottom: 1px solid var(--border);
}
.search-item:last-child { border-bottom: none; }
.search-item:hover { background: var(--paper); }
.search-item-name { font-weight: 700; font-size: 13.5px; color: var(--ink-900); }
.search-item-sub { font-size: 11.5px; color: var(--ink-500); font-family: var(--font-mono); }
.search-empty { padding: 18px; text-align: center; color: var(--ink-400); font-size: 13px; }

.topbar-spacer { flex: 1; }

.topbar-actions { display: flex; align-items: center; gap: 10px; }

.icon-btn {
    width: 40px; height: 40px; border-radius: 50%;
    border: 1px solid var(--border); background: var(--surface);
    display: flex; align-items: center; justify-content: center;
    font-size: 16px; cursor: pointer; color: var(--ink-700);
    transition: all .15s ease;
}
.icon-btn:hover { border-color: var(--teal-500); color: var(--teal-600); transform: translateY(-1px); }

.page-body { padding: 28px 32px 60px; flex: 1; }

/* Pages */
.page { display: none; animation: fadein .25s ease; }
.page.active { display: block; }
@keyframes fadein { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

.page-header { margin-bottom: 26px; display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; }
.page-header-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.page-eyebrow { font-family: var(--font-mono); font-size: 11.5px; font-weight: 600; color: var(--teal-600); letter-spacing: 1.2px; margin-bottom: 6px; }
.page-header h1 { font-size: 25px; font-weight: 800; color: var(--ink-900); }
.page-header p { color: var(--ink-500); margin-top: 4px; font-size: 13.5px; }

/* =========================================================
   Buttons
   ========================================================= */
.btn {
    padding: 11px 20px; border: none; border-radius: 11px;
    font-size: 13.5px; font-weight: 700; cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
    transition: transform .12s ease, box-shadow .12s ease, background .15s ease;
    white-space: nowrap;
}
.btn:active { transform: scale(0.97); }

.btn-primary { background: var(--navy-800); color: #fff; box-shadow: 0 2px 10px rgba(15,28,51,0.18); }
.btn-primary:hover { background: var(--navy-700); }

.btn-teal { background: var(--teal-500); color: var(--navy-950); box-shadow: 0 2px 10px rgba(45,212,191,0.3); }
.btn-teal:hover { background: var(--teal-600); }

.btn-ghost { background: var(--surface); color: var(--ink-700); border: 1px solid var(--border); }
.btn-ghost:hover { border-color: var(--border-strong); }

.btn-danger-ghost { background: var(--danger-bg); color: var(--danger); }
.btn-danger-ghost:hover { filter: brightness(0.96); }

.btn-sm { padding: 8px 14px; font-size: 12.5px; border-radius: 9px; }
.btn-block { width: 100%; justify-content: center; }

/* =========================================================
   Stat cards — "ticket" motif
   ========================================================= */
.stats-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 18px; margin-bottom: 30px;
}

.ticket {
    position: relative;
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
    padding: 22px 22px 20px;
    overflow: hidden;
    border: 1px solid var(--border);
}

.ticket::after {
    content: '';
    position: absolute; left: -1px; right: -1px; bottom: 54px;
    height: 0;
    border-bottom: 2px dashed var(--border);
}

.ticket::before {
    content: '';
    position: absolute; left: -10px; bottom: 46px;
    width: 20px; height: 20px; border-radius: 50%;
    background: var(--paper);
    box-shadow: 236px 0 0 var(--paper);
}

.ticket-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 14px; }
.ticket-icon {
    width: 42px; height: 42px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    font-size: 19px; flex-shrink: 0;
}
.ticket-icon.i-navy  { background: var(--navy-800); color: #fff; }
.ticket-icon.i-teal  { background: var(--teal-50); color: var(--teal-600); }
.ticket-icon.i-amber { background: var(--amber-50); color: var(--amber-500); }
.ticket-icon.i-info  { background: var(--info-bg); color: var(--info); }

.ticket-trend { font-family: var(--font-mono); font-size: 11px; font-weight: 600; color: var(--success); background: var(--success-bg); padding: 3px 8px; border-radius: 20px; }

.ticket-label { font-size: 12.5px; color: var(--ink-500); font-weight: 600; margin-bottom: 4px; }
.ticket-value { font-family: var(--font-mono); font-size: 28px; font-weight: 700; color: var(--ink-900); letter-spacing: -0.5px; }

.ticket-foot { margin-top: 20px; padding-top: 14px; font-size: 12px; color: var(--ink-500); display: flex; justify-content: space-between; }
.ticket-foot b { color: var(--ink-700); font-family: var(--font-mono); }

/* =========================================================
   Recent panels
   ========================================================= */
.recent-section { display: grid; grid-template-columns: repeat(auto-fit, minmax(380px, 1fr)); gap: 20px; }

.panel { background: var(--surface); border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-card); padding: 22px; }
.panel-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
.panel-head h3 { font-size: 15px; font-weight: 700; color: var(--ink-900); }
.panel-head a { font-size: 12px; color: var(--teal-600); font-weight: 700; cursor: pointer; }

.mini-row {
    display: flex; justify-content: space-between; align-items: center;
    padding: 12px; border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    margin-bottom: 8px;
}
.mini-row:last-child { margin-bottom: 0; }
.mini-name { font-weight: 700; font-size: 13.5px; color: var(--ink-900); }
.mini-sub { font-size: 11.5px; color: var(--ink-500); font-family: var(--font-mono); margin-top: 2px; }
.mini-amount { font-family: var(--font-mono); font-weight: 700; font-size: 14px; }

/* =========================================================
   Filters + Table
   ========================================================= */
.filters { display: flex; gap: 12px; margin-bottom: 18px; flex-wrap: wrap; }
.filter-input, .filter-select {
    padding: 11px 15px; border-radius: 11px; border: 1px solid var(--border);
    background: var(--surface); font-size: 13.5px; color: var(--ink-900);
}
.filter-input { flex: 1; min-width: 220px; }
.filter-select { min-width: 160px; }
.filter-input:focus, .filter-select:focus { border-color: var(--teal-500); outline: none; }

.table-card { background: var(--surface); border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-card); overflow: hidden; }
.table-wrap { overflow-x: auto; }

.data-table { width: 100%; border-collapse: collapse; min-width: 720px; }
.data-table th {
    background: var(--paper); padding: 13px 16px; text-align: right;
    font-size: 11.5px; font-weight: 700; color: var(--ink-500);
    letter-spacing: .4px; border-bottom: 1px solid var(--border);
    white-space: nowrap;
}
.data-table td { padding: 15px 16px; border-bottom: 1px solid var(--border); font-size: 13.5px; color: var(--ink-700); }
.data-table tr:last-child td { border-bottom: none; }
.data-table tr:hover td { background: var(--paper); }
.mono { font-family: var(--font-mono); font-weight: 600; color: var(--ink-900); }

.action-btns { display: flex; gap: 6px; }
.action-btn {
    width: 32px; height: 32px; border: none; border-radius: 8px; cursor: pointer;
    background: transparent; color: var(--ink-400); font-size: 14px;
    display: flex; align-items: center; justify-content: center;
    transition: all .15s ease;
}
.action-btn:hover { background: var(--paper); }
.action-btn.view:hover { color: var(--info); }
.action-btn.edit:hover { color: var(--amber-500); }
.action-btn.delete:hover { color: var(--danger); }
.action-btn.link { color: var(--danger); }
.action-btn.link:hover { color: var(--danger); background: var(--danger-bg); }

/* =========================================================
   Status badges — "stamp" motif
   ========================================================= */
.stamp {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 5px 12px; border-radius: 20px;
    font-size: 11px; font-weight: 700;
    font-family: var(--font-mono);
    border: 1.5px dashed currentColor;
}
.stamp::before { content: ''; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }

.stamp-new       { color: var(--info); background: var(--info-bg); }
.stamp-pending, .stamp-in_progress { color: var(--amber-500); background: var(--amber-50); }
.stamp-finished, .stamp-completed  { color: var(--success); background: var(--success-bg); }
.stamp-delivered { color: #7c3aed; background: #f2ecfd; }
.stamp-cancelled, .stamp-rejected { color: var(--danger); background: var(--danger-bg); }
.stamp-waiting   { color: var(--amber-500); background: var(--amber-50); }
.stamp-accepted  { color: var(--success); background: var(--success-bg); }
.stamp-paid      { color: var(--success); background: var(--success-bg); }
.stamp-unpaid    { color: var(--danger); background: var(--danger-bg); }
.stamp-clickable { cursor: pointer; user-select: none; transition: filter .15s ease, transform .1s ease; }
.stamp-clickable:hover  { filter: brightness(0.95); }
.stamp-clickable:active { transform: scale(0.97); }

/* Inline editable status dropdown (looks like a stamp, acts like a select) */
select.stamp-select {
    appearance: none; -webkit-appearance: none; -moz-appearance: none;
    cursor: pointer; outline: none;
    padding: 5px 30px 5px 12px;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path d='M1 1l4 4 4-4' stroke='%23888' stroke-width='1.5' fill='none' stroke-linecap='round' stroke-linejoin='round'/></svg>");
    background-repeat: no-repeat;
    background-position: left 10px center;
}
select.stamp-select:hover { filter: brightness(0.97); }
select.stamp-select:focus { border-style: solid; }

/* =========================================================
   Orders grid
   ========================================================= */
.orders-grid { display: flex; flex-direction: column; gap: 10px; }

/* Compact single-line row (extra details tucked into an optional expandable strip) */
.order-card {
    background: var(--surface); border-radius: var(--radius-md); border: 1px solid var(--border);
    box-shadow: var(--shadow-card); padding: 12px 16px;
    display: flex; align-items: center; gap: 14px; flex-wrap: wrap;
}
.order-card-id { display: flex; flex-direction: column; gap: 2px; min-width: 120px; flex: 0 0 auto; }
.order-num { font-family: var(--font-mono); font-size: 10.5px; color: var(--ink-400); }
.order-name { font-weight: 700; font-size: 14px; color: var(--ink-900); }

.order-card-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; flex: 1 1 260px; min-width: 0; }
.order-service-tag { display: inline-block; font-size: 11px; font-weight: 700; color: var(--price-ink); background: var(--paper); padding: 4px 9px; border-radius: 7px; white-space: nowrap; }
.order-desc { font-size: 11.5px; color: var(--ink-500); line-height: 1.5; max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.order-contact { font-size: 11.5px; color: var(--ink-500); display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }

.order-card-side { display: flex; align-items: center; gap: 10px; margin-inline-start: auto; flex: 0 0 auto; }
.order-price { font-family: var(--font-mono); font-size: 16px; font-weight: 700; color: var(--price-ink); white-space: nowrap; }

.order-quick-actions { display: flex; gap: 6px; }
.btn-accept, .btn-reject {
    border-radius: 8px; padding: 7px 10px; font-weight: 700; font-size: 11.5px;
    cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 4px;
    white-space: nowrap; transition: all .15s ease;
}
.btn-accept { background: var(--success-bg); color: var(--success); border: 1.5px solid var(--success); }
.btn-accept:hover { background: var(--success); color: #fff; }
.btn-reject { background: var(--danger-bg); color: var(--danger); border: 1.5px solid var(--danger); }
.btn-reject:hover { background: var(--danger); color: #fff; }

/* Extra details (full description / contact fields / attachment) — hidden until expanded */
.order-card-more { flex: 1 1 100%; display: none; padding-top: 10px; margin-top: 4px; border-top: 1px dashed var(--border); gap: 6px; flex-wrap: wrap; }
.order-card-more.show { display: flex; }
.order-more-toggle { flex: 0 0 auto; background: none; border: none; color: var(--price-ink); font-size: 11px; font-weight: 700; cursor: pointer; padding: 4px 6px; text-decoration: underline; }

@media (max-width: 640px) {
    .order-card { flex-direction: column; align-items: stretch; }
    .order-card-side { margin-inline-start: 0; width: 100%; justify-content: space-between; }
}

/* =========================================================
   Promo stats mini strip
   ========================================================= */
.stats-mini { display: flex; gap: 14px; margin-bottom: 22px; flex-wrap: wrap; }
.stat-mini { background: var(--surface); border: 1px solid var(--border); padding: 16px 22px; border-radius: var(--radius-md); display: flex; flex-direction: column; gap: 4px; min-width: 160px; }
.stat-mini span { font-size: 11.5px; color: var(--ink-500); font-weight: 600; }
.stat-mini strong { font-family: var(--font-mono); font-size: 19px; color: var(--ink-900); }

.code-chip { font-family: var(--font-mono); font-weight: 700; color: var(--price-ink); background: var(--paper); padding: 4px 10px; border-radius: 7px; letter-spacing: .5px; }

.progress-track { width: 100%; height: 6px; border-radius: 4px; background: var(--border); overflow: hidden; margin-top: 6px; }
.progress-fill { height: 100%; background: var(--teal-500); border-radius: 4px; }

.discount-cell { display: flex; align-items: center; gap: 6px; }
.discount-cell input { width: 78px; padding: 7px 9px; border-radius: 7px; border: 1px solid var(--border); font-size: 12.5px; }

/* =========================================================
   Modal
   ========================================================= */
.modal-overlay {
    display: none; position: fixed; inset: 0; background: rgba(12,21,38,0.55);
    backdrop-filter: blur(2px);
    z-index: 1000; align-items: center; justify-content: center; padding: 20px;
}
.modal-overlay.active { display: flex; }

.modal-box {
    background: var(--surface); border-radius: 22px; width: 100%; max-width: 720px;
    max-height: 90vh; overflow: auto; box-shadow: var(--shadow-pop);
    animation: pop .2s ease;
}
.modal-box.modal-sm { max-width: 460px; }
.modal-box.modal-lg { max-width: 860px; }
@keyframes pop { from { opacity: 0; transform: scale(.96) translateY(8px); } to { opacity: 1; transform: scale(1) translateY(0); } }

.modal-head { display: flex; justify-content: space-between; align-items: center; padding: 22px 26px; border-bottom: 1px solid var(--border); }
.modal-head h2 { font-size: 17px; font-weight: 800; color: var(--ink-900); }
.modal-close { width: 34px; height: 34px; border-radius: 50%; border: none; background: var(--paper); color: var(--ink-500); font-size: 18px; cursor: pointer; }
.modal-close:hover { background: var(--danger-bg); color: var(--danger); }

.modal-body { padding: 24px 26px; }
.modal-foot { display: flex; gap: 12px; margin-top: 24px; }
.modal-foot .btn { flex: 1; }

/* =========================================================
   Forms
   ========================================================= */
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.form-group { margin-bottom: 16px; }
.form-group label { display: block; font-size: 12.5px; font-weight: 700; color: var(--ink-700); margin-bottom: 7px; }
.form-group input, .form-group select, .form-group textarea {
    width: 100%; padding: 11px 14px; border-radius: 11px; border: 1.5px solid var(--border);
    background: var(--paper); font-size: 13.5px; color: var(--ink-900);
}
.form-group input:focus, .form-group select:focus, .form-group textarea:focus {
    outline: none; border-color: var(--teal-500); background: var(--surface);
}
.form-group textarea { resize: vertical; min-height: 80px; }

.checkbox-row { display: flex; align-items: center; gap: 9px; cursor: pointer; font-size: 13px; font-weight: 600; color: var(--ink-700); }
.checkbox-row input { width: auto; }

.input-with-btn { display: flex; gap: 8px; }
.input-with-btn input { flex: 1; }

/* =========================================================
   Service line items (multi-service invoice/order rows)
   ========================================================= */
.service-items-head {
    display: grid; grid-template-columns: 2fr 1fr .7fr 1fr 1fr 1fr 30px; gap: 8px;
    padding: 0 4px 6px; font-size: 10.5px; font-weight: 700; color: var(--ink-500);
    letter-spacing: .3px;
}
.service-items { display: flex; flex-direction: column; gap: 8px; }
.service-row {
    display: grid; grid-template-columns: 2fr 1fr .7fr 1fr 1fr 1fr 30px; gap: 8px;
    align-items: center; background: var(--paper); border: 1.5px solid var(--border);
    border-radius: 12px; padding: 9px;
}
.service-row select, .service-row input {
    width: 100%; padding: 8px 9px; border-radius: 8px; border: 1.5px solid var(--border);
    background: var(--surface); font-size: 12px; color: var(--ink-900);
}
.service-row select:focus, .service-row input:focus { outline: none; border-color: var(--teal-500); }
.service-row-total { font-family: var(--font-mono); font-weight: 700; color: var(--price-ink); font-size: 12.5px; text-align: center; }
.service-row-remove {
    width: 28px; height: 28px; border: none; border-radius: 7px; background: transparent;
    color: var(--danger); cursor: pointer; font-size: 14px;
    display: flex; align-items: center; justify-content: center; transition: background .15s ease;
}
.service-row-remove:hover { background: var(--danger-bg); }

.add-service-btn {
    border: 1.5px dashed var(--teal-500); color: var(--teal-600); background: var(--teal-50);
    border-radius: 11px; padding: 11px; font-size: 13px; font-weight: 700; cursor: pointer;
    width: 100%; margin-top: 10px; transition: background .15s ease;
}
.add-service-btn:hover { background: #d9f7f1; }

.service-summary {
    background: var(--paper); border-radius: 12px; padding: 16px 18px; margin: 6px 0 16px;
    display: flex; flex-direction: column; gap: 8px;
}
.service-summary-row { display: flex; justify-content: space-between; font-size: 13px; color: var(--ink-700); }
.service-summary-row.total {
    font-size: 16.5px; font-weight: 800; color: var(--price-ink);
    border-top: 1px dashed var(--border-strong); padding-top: 9px; margin-top: 2px;
}

@media (max-width: 640px) {
    .service-items-head { display: none; }
    .service-row {
        grid-template-columns: 1fr 1fr; grid-template-areas:
            "service service"
            "price qty"
            "promo discount"
            "total remove";
    }
    .service-row select { grid-area: service; }
    .service-row .svc-price { grid-area: price; }
    .service-row .svc-qty { grid-area: qty; }
    .service-row .svc-promo { grid-area: promo; }
    .service-row .svc-discount { grid-area: discount; }
    .service-row-total { grid-area: total; text-align: right; }
    .service-row-remove { grid-area: remove; justify-self: end; }
}

/* =========================================================
   Invoice document view — "certificate" motif
   ========================================================= */
.doc-sheet { background: var(--surface); border-radius: 16px; overflow: hidden; border: 1px solid var(--border); }
.doc-head {
    background: linear-gradient(135deg, var(--navy-900), var(--navy-700));
    color: #fff; padding: 26px; display: flex; justify-content: space-between; align-items: center;
    position: relative;
}
.doc-head::after { content: ''; position: absolute; inset: 0; background: radial-gradient(circle at 90% -10%, rgba(45,212,191,0.25), transparent 55%); }
.doc-brand { position: relative; z-index: 1; }
.doc-brand h3 { font-size: 21px; font-weight: 800; }
.doc-brand p { font-size: 12px; opacity: .7; margin-top: 2px; }
.doc-meta { text-align: left; position: relative; z-index: 1; }
.doc-meta label { font-size: 10px; opacity: .65; letter-spacing: 1px; }
.doc-meta div { font-family: var(--font-mono); font-size: 17px; font-weight: 700; }

.doc-section { padding: 22px 26px; border-bottom: 1px dashed var(--border); }
.doc-section:last-child { border-bottom: none; }
.doc-section h4 { font-size: 12px; font-weight: 700; color: var(--ink-500); letter-spacing: .5px; margin-bottom: 12px; text-transform: uppercase; }
.doc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
.doc-field span { color: var(--ink-500); font-size: 12.5px; }
.doc-field b { color: var(--ink-900); font-size: 13.5px; }

.doc-total { display: flex; justify-content: space-between; align-items: center; background: var(--paper); padding: 20px 26px; }
.doc-total-label { font-size: 15px; font-weight: 700; color: var(--ink-700); }
.doc-total-value { font-family: var(--font-mono); font-size: 26px; font-weight: 800; color: var(--price-ink); }

.doc-signature { padding: 22px 26px 26px; border-top: 1px dashed var(--border); }
.doc-signature-label { font-size: 12px; font-weight: 700; color: var(--ink-700); margin-bottom: 4px; }
.doc-signature-name {
    font-family: 'Brush Script MT', cursive;
    font-size: 26px; color: var(--teal-600); font-weight: 700;
    padding-bottom: 6px; border-bottom: 1px solid var(--border-strong);
    display: inline-block; min-width: 200px;
}
.doc-signature-note { font-size: 11px; color: var(--ink-500); font-style: italic; margin-top: 6px; }

/* =========================================================
   Empty state
   ========================================================= */
.empty-state { text-align: center; padding: 70px 20px; color: var(--ink-400); }
.empty-state-icon { font-size: 46px; margin-bottom: 14px; opacity: .6; }
.empty-state p { font-size: 13.5px; font-weight: 600; }

/* =========================================================
   Toast
   ========================================================= */
.toast {
    position: fixed; bottom: 26px; left: 50%; transform: translateX(-50%) translateY(120px);
    padding: 14px 26px; border-radius: 14px; color: #fff; font-weight: 700; font-size: 13.5px;
    z-index: 2000; transition: transform .3s cubic-bezier(.2,.9,.3,1.2); box-shadow: var(--shadow-pop);
    display: flex; align-items: center; gap: 10px;
}
.toast.show { transform: translateX(-50%) translateY(0); }
.toast-success { background: var(--success); }
.toast-error { background: var(--danger); }

/* =========================================================
   Responsive
   ========================================================= */
@media (max-width: 1024px) {
    .sidebar { transform: translateX(100%); box-shadow: var(--shadow-pop); }
    .sidebar.open { transform: translateX(0); }
    .main-content { margin-right: 0; }
    .menu-toggle { display: flex; align-items: center; justify-content: center; }
    .form-row { grid-template-columns: 1fr; }
    .doc-grid { grid-template-columns: 1fr; }
}

@media (max-width: 560px) {
    .page-body { padding: 20px 16px 50px; }
    .topbar { padding: 14px 16px; }
    .search-box { max-width: none; }
}

@media print {
    .sidebar, .topbar, .btn, .action-btns, .bottom-hint { display: none !important; }
    .main-content { margin: 0; }
    body { background: #fff; }
}


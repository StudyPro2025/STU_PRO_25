function quickSearch() {
    const query = document.getElementById('main-search').value.toLowerCase().trim();
    const dropdown = document.getElementById('search-results');
    if (query.length < 2) { dropdown.classList.remove('show'); return; }

    let html = '';
    invoices.filter(i => (i.name||'').toLowerCase().includes(query) || (i.number||'').toLowerCase().includes(query))
        .slice(0, 5).forEach(i => {
            html += `<div class="search-item" onclick="goToInvoice('${i.id}')">
                <div><div class="search-item-name">${escapeHtml(i.name)}</div><div class="search-item-sub">${escapeHtml(i.number)}</div></div>
                <span class="stamp stamp-new">فاتورة</span>
            </div>`;
        });
    orders.filter(o => (o.name||'').toLowerCase().includes(query) || (o.number||'').toLowerCase().includes(query))
        .slice(0, 5).forEach(o => {
            html += `<div class="search-item" onclick="goToOrders()">
                <div><div class="search-item-name">${escapeHtml(o.name)}</div><div class="search-item-sub">${escapeHtml(o.number)}</div></div>
                <span class="stamp stamp-pending">طلب</span>
            </div>`;
        });
    promocodes.filter(p => (p.code||'').toLowerCase().includes(query))
        .slice(0, 5).forEach(p => {
            html += `<div class="search-item" onclick="goToPromocodes()">
                <div><div class="search-item-name">${escapeHtml(p.code)}</div><div class="search-item-sub">${escapeHtml(p.invoice)||'عام'}</div></div>
                <span class="stamp stamp-delivered">بروموكود</span>
            </div>`;
        });

    dropdown.innerHTML = html || `<div class="search-empty">لا توجد نتائج</div>`;
    dropdown.classList.add('show');
}


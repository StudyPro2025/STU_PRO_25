// Orders reach the "accepted" stage (and beyond) once approved — payment
// status is only meaningful from that point on.
const PAID_TRACKED_STATUSES = ['accepted', 'in_progress', 'completed'];

function applyOrderFilters() {
    const search = (document.getElementById('order-search')?.value || '').toLowerCase();
    const status = document.getElementById('order-status-filter')?.value || 'all';
    const payment = document.getElementById('order-payment-filter')?.value || 'all';
    return orders.filter(o => {
        const matchSearch = (o.name || '').toLowerCase().includes(search) ||
            (o.number || '').toLowerCase().includes(search) ||
            (o.service || '').toLowerCase().includes(search);
        const matchStatus = status === 'all' || o.status === status;
        const isPaidTracked = PAID_TRACKED_STATUSES.includes(o.status);
        const matchPayment = payment === 'all' ||
            (payment === 'paid' && isPaidTracked && o.paid) ||
            (payment === 'unpaid' && isPaidTracked && !o.paid);
        return matchSearch && matchStatus && matchPayment;
    });
}

function filterOrders() { renderOrdersGrid(applyOrderFilters()); }


// =============================================================
// Service line items — shared by Invoice & Order forms
// (lets a single invoice/order include more than one service)
// =============================================================
let serviceRowSeq = 0;

function addServiceRow(prefix, item = null) {
    const container = document.getElementById(prefix + '-items');
    if (!container) return null;
    const rowId = 'svc' + (++serviceRowSeq);
    const row = document.createElement('div');
    row.className = 'service-row';
    row.dataset.rowId = rowId;
    row.innerHTML = `
        <select class="svc-service">
            <option value="">-- اختر الخدمة --</option>
            ${SERVICE_OPTIONS.map(s => `<option value="${escapeHtml(s)}">${escapeHtml(s)}</option>`).join('')}
        </select>
        <input type="number" class="svc-price mono" min="0" step="0.01" value="0">
        <input type="number" class="svc-qty mono" min="1" step="1" value="1">
        <input type="text" class="svc-promo mono" placeholder="اختياري">
        <input type="number" class="svc-discount mono" min="0" step="0.01" value="0">
        <span class="service-row-total">$0.00</span>
        <button type="button" class="service-row-remove" title="حذف الخدمة">✕</button>
    `;
    container.appendChild(row);

    if (item) {
        row.querySelector('.svc-service').value = item.service || '';
        row.querySelector('.svc-price').value = item.price || 0;
        row.querySelector('.svc-qty').value = item.qty || 1;
        row.querySelector('.svc-promo').value = item.promo || '';
        row.querySelector('.svc-discount').value = item.discount || 0;
    }

    row.querySelector('.service-row-remove').addEventListener('click', () => {
        // Always keep at least one row so the form stays usable
        if (container.querySelectorAll('.service-row').length <= 1) {
            showToast('لازم يكون فيه خدمة واحدة على الأقل', 'error');
            return;
        }
        row.remove();
        recalcServiceTotals(prefix);
    });
    row.querySelectorAll('input, select').forEach(el => {
        el.addEventListener('input', () => recalcServiceTotals(prefix));
    });
    row.querySelector('.svc-promo').addEventListener('change', (e) => applyPromoToRow(prefix, row, e.target.value));

    recalcServiceTotals(prefix);
    return row;
}

function applyPromoToRow(prefix, row, code) {
    code = (code || '').trim().toUpperCase();
    if (!code) return;
    const promo = promocodes.find(p => (p.code || '').toUpperCase() === code);
    if (!promo) { showToast('البروموكود غير موجود', 'error'); return; }
    if (!promo.unlimited && promo.validUntil && new Date(promo.validUntil) < new Date()) {
        showToast('البروموكود منتهي الصلاحية', 'error'); return;
    }
    const usedCount = Number(promo.usedCount) || 0;
    const maxUses = promo.maxUses ? Number(promo.maxUses) : null;
    if (maxUses && usedCount >= maxUses) {
        showToast(`البروموكود وصل للحد الأقصى للاستخدام (${maxUses} مرة)`, 'error');
        row.querySelector('.svc-promo').value = '';
        return;
    }
    const price = parseFloat(row.querySelector('.svc-price').value) || 0;
    const qty = parseFloat(row.querySelector('.svc-qty').value) || 1;
    const lineTotal = price * qty;
    const remaining = promo.unlimited ? lineTotal : Math.max(0, Number(promo.remaining ?? promo.budget ?? 0));
    const discount = Math.min(lineTotal, remaining);
    row.querySelector('.svc-discount').value = discount.toFixed(2);
    recalcServiceTotals(prefix);
    // Let the admin see how many times this code has already been used before saving
    const usesLabel = maxUses ? `(${usedCount}/${maxUses} مرة)` : (usedCount ? `(اتستخدم ${usedCount} مرة قبل كده)` : '');
    showToast(`تم تطبيق البروموكود ${usesLabel}`.trim(), 'success');
}

function recalcServiceTotals(prefix) {
    const container = document.getElementById(prefix + '-items');
    if (!container) return;
    let subtotal = 0, discountTotal = 0;
    container.querySelectorAll('.service-row').forEach(row => {
        const price = parseFloat(row.querySelector('.svc-price').value) || 0;
        const qty = parseFloat(row.querySelector('.svc-qty').value) || 1;
        const discount = parseFloat(row.querySelector('.svc-discount').value) || 0;
        const total = Math.max(0, price * qty - discount);
        row.querySelector('.service-row-total').textContent = '$' + total.toFixed(2);
        subtotal += price * qty;
        discountTotal += discount;
    });
    const grandTotal = Math.max(0, subtotal - discountTotal);
    setText(prefix + '-subtotal', '$' + subtotal.toFixed(2));
    setText(prefix + '-discount-total', '-$' + discountTotal.toFixed(2));
    setText(prefix + '-total-display', '$' + grandTotal.toFixed(2));
    const totalField = document.getElementById(prefix + '-amount') || document.getElementById(prefix + '-price');
    if (totalField) totalField.value = grandTotal.toFixed(2);
}

function getServiceItems(prefix) {
    const container = document.getElementById(prefix + '-items');
    if (!container) return [];
    return Array.from(container.querySelectorAll('.service-row')).map(row => {
        const price = parseFloat(row.querySelector('.svc-price').value) || 0;
        const qty = parseFloat(row.querySelector('.svc-qty').value) || 1;
        const discount = parseFloat(row.querySelector('.svc-discount').value) || 0;
        return {
            service: row.querySelector('.svc-service').value,
            price, qty,
            promo: row.querySelector('.svc-promo').value.trim(),
            discount,
            total: Math.max(0, price * qty - discount)
        };
    }).filter(it => it.service || it.price);
}


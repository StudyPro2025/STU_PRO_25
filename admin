// إلغاء الربط بين طلب وفاتورة: بتتنقل الفاتورة لسلة المهملات (زي أي حذف عادي، تقدر تسترجعها منها لو غلطت)،
// وبيترجع الخصم في البروموكود لو كان فيه، وبيتشال invoiceId/invoiceNumber من الطلب وترجع حالته "قائمة الانتظار"
// عشان تقدر تقبله تاني من الأول من غير ما يوقفك بحجة إنه اتقبل قبل كده.
function unlinkOrderFromInvoice(orderId) {
    const o = orders.find(x => x.id === orderId);
    if (!o || !o.invoiceId) { showToast('الطلب ده مش مربوط بفاتورة', 'error'); return; }
    if (!confirm('هتلغي الربط بين الطلب والفاتورة ' + (o.invoiceNumber || '') + '، والفاتورة هتتنقل لسلة المهملات وحالة الطلب هترجع "قائمة الانتظار". متأكد؟')) return;

    const clearOrderLink = () => db.collection('orders').doc(orderId).update({
        invoiceId: firebase.firestore.FieldValue.delete(),
        invoiceNumber: firebase.firestore.FieldValue.delete(),
        status: 'waiting'
    });

    const inv = invoices.find(i => i.id === o.invoiceId);
    if (!inv) {
        // الفاتورة مش موجودة أصلاً (اتمسحت من مكان تاني) — بس ننضف الطلب
        clearOrderLink()
            .then(() => showToast('تم إلغاء الربط', 'success'))
            .catch(() => showToast('حدث خطأ أثناء إلغاء الربط', 'error'));
        return;
    }

    const { id: _drop, ...invData } = inv;
    moveToTrash('invoice', inv.id, invData)
        .then(() => db.collection('invoices').doc(inv.id).delete())
        .then(() => {
            const usage = getPromoUsageMap(inv.items);
            const refundMap = {};
            Object.keys(usage).forEach(code => {
                refundMap[code] = { discount: -usage[code].discount, count: -usage[code].count };
            });
            return applyPromoUsageDelta(refundMap);
        })
        .then(clearOrderLink)
        .then(() => showToast('اتلغى الربط، والفاتورة اتنقلت لسلة المهملات، والطلب رجع لقائمة الانتظار', 'success'))
        .catch(() => showToast('حدث خطأ أثناء إلغاء الربط', 'error'));
}

function acceptOrder(id) {
    const o = orders.find(x => x.id === id);
    if (!o) { showToast('تعذر العثور على الطلب', 'error'); return; }
    if (o.status === 'accepted' || o.invoiceId) {
        showToast('الطلب ده اتقبل وتحول لفاتورة قبل كده', 'error');
        return;
    }

    // Carry the order's service line items over to the invoice (fallback to a single row for older orders)
    const items = (Array.isArray(o.items) && o.items.length)
        ? o.items
        : [{ service: o.service || '', price: o.price || 0, qty: 1, promo: '', discount: 0, total: o.price || 0 }];

    const invoiceData = {
        number: nextInvoiceNumber(),
        name: o.name || '',
        phone: o.phone || o.contact || '',
        level: o.level || '',
        university: o.university || '',
        items: items,
        subject: items.map(it => it.service).filter(Boolean).join('، '),
        subtotal: o.subtotal || 0,
        discountTotal: o.discountTotal || 0,
        email: o.email || '',
        payment: o.payment || '',
        ref: '',
        amount: o.price || 0,
        status: 'new',
        paid: o.paid || false,
        deliveredFileUrl: o.deliveredFileUrl || '',
        paymentLink: o.paymentLink || '',
        notes: o.description || '',
        orderId: o.id,
        orderNumber: o.number || '',
        created: new Date().toISOString()
    };

    db.collection('invoices').add(invoiceData)
        .then(invRef => db.collection('orders').doc(id).update({ status: 'accepted', invoiceId: invRef.id, invoiceNumber: invoiceData.number }))
        .then(() => applyPromoUsageDelta(getPromoUsageMap(items)))
        .then(() => showToast('تم قبول الطلب وتحويله للفواتير بحالة جديد', 'success'))
        .catch(() => showToast('حدث خطأ أثناء التحديث', 'error'));
}


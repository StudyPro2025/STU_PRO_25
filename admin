function refreshPromocodes() {
    setText('promocodes-count', promocodes.length);
    const totalBudget = promocodes.reduce((s, p) => s + (Number(p.budget) || 0), 0);
    const totalRemaining = promocodes.reduce((s, p) => s + (Number(p.remaining) || 0), 0);
    setText('promo-total-budget', '$' + totalBudget.toLocaleString());
    setText('promo-used', '$' + (totalBudget - totalRemaining).toLocaleString());
    setText('promo-remaining', '$' + totalRemaining.toLocaleString());
    renderPromocodesTable(promocodes);
}

function renderPromocodesTable(data) {
    const tbody = document.getElementById('promocodes-tbody');
    if (!data.length) {
        tbody.innerHTML = `<tr><td colspan="8">${emptyState('🎫', 'لا توجد بروموكود بعد')}</td></tr>`;
        return;
    }
    tbody.innerHTML = data.map(p => {
        const budget = Number(p.budget) || 0;
        const remaining = Number(p.remaining) || 0;
        const used = budget - remaining;
        const pct = budget > 0 ? Math.min(100, Math.round((used / budget) * 100)) : 0;
        const isExpired = !p.unlimited && p.validUntil && new Date(p.validUntil) < new Date();
        const usedCount = Number(p.usedCount) || 0;
        const maxUses = p.maxUses ? Number(p.maxUses) : null;
        const isMaxedOut = maxUses && usedCount >= maxUses;
        return `
        <tr style="${isExpired ? 'opacity:.55' : ''}">
            <td><span class="code-chip">${escapeHtml(p.code)}</span></td>
            <td>${escapeHtml(p.invoice) || 'عام'}</td>
            <td class="mono">$${budget.toLocaleString()}</td>
            <td>
                <div class="mono" style="color:var(--danger)">$${used.toLocaleString()}</div>
                <div class="progress-track"><div class="progress-fill" style="width:${pct}%"></div></div>
            </td>
            <td class="mono" style="color:var(--success); font-weight:700;">$${remaining.toLocaleString()}</td>
            <td class="mono" style="${isMaxedOut ? 'color:var(--danger); font-weight:700;' : ''}">${maxUses ? `${usedCount} / ${maxUses}${isMaxedOut ? ' 🚫' : ''}` : `${usedCount} مرة`}</td>
            <td>${p.unlimited ? '♾️ بدون تاريخ' : (isExpired ? `<span style="color:var(--danger)">${new Date(p.validUntil).toLocaleDateString('ar-EG')}</span>` : new Date(p.validUntil).toLocaleDateString('ar-EG'))}</td>
            <td>
                <div class="action-btns">
                    <button class="action-btn delete" onclick="deletePromo('${p.id}')" title="حذف">🗑️</button>
                </div>
            </td>
        </tr>`;
    }).join('');
}


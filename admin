function nextInvoiceNumber() {
    // ملحوظة: الرقم ده تلقائي بس، والفاتورة بتتحفظ فعليًا لما الأدمن يدوس "حفظ"
    // فمعرفش أعمله transaction فوري هنا لأنه بيتحط في الفورم قبل الحفظ بوقت؛
    // التكرار بيتمنع فعليًا في submit handler اللي بيرفض أي رقم فاتورة مستخدم قبل كده.
    //
    // بيحسب أعلى رقم فاتورة موجود فعليًا للسنة دي (مش عدد الفواتير) عشان لو
    // اتمسحت فاتورة في النص (اتنقلت لسلة المهملات)، الرقم الجديد يكمل بعد
    // أعلى رقم صادر فعلاً بدل ما يرجع لعدد الفواتير المتبقية.
    const year = new Date().getFullYear();
    const prefix = `STP-${year}-`;
    let max = 0;
    invoices.forEach(inv => {
        const num = String(inv.number || '');
        if (num.indexOf(prefix) === 0) {
            const n = parseInt(num.slice(prefix.length), 10);
            if (!isNaN(n) && n > max) max = n;
        }
    });
    return prefix + String(max + 1).padStart(4, '0');
}

function todayDateInputValue() {
    const d = new Date();
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
}


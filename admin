// بيولّد رقم تسلسلي فريد باستخدام Firestore transaction، عشان لو طلبين اتبعتوا في نفس اللحظة
// ما ياخدوش نفس الرقم (بدل الاعتماد على orders.length اللي ممكن يتقرأ قبل ما يتزامن)
async function nextSequentialNumber(prefix, counterId) {
    const counterRef = db.collection('counters').doc(counterId);
    try {
        const newCount = await db.runTransaction(async (transaction) => {
            const doc = await transaction.get(counterRef);
            if (doc.exists) {
                const next = (doc.data().count || 0) + 1;
                transaction.set(counterRef, { count: next }, { merge: true });
                return next;
            }
            return null; // العداد لسه معملوش؛ هنظبطه تحت أول مرة بس
        });
        if (newCount !== null) return prefix + String(newCount).padStart(4, '0');
    } catch (e) { /* هنكمل على الخطة البديلة تحت */ }

    // أول مرة بس: بنجيب أعلى رقم موجود فعليًا في الطلبات عشان منكررش أرقام قديمة
    try {
        const snap = await db.collection('orders')
            .where('number', '>=', prefix).where('number', '<', prefix + '\uf8ff').get();
        let max = 0;
        snap.forEach(doc => {
            const n = parseInt(String(doc.data().number || '').slice(prefix.length), 10);
            if (!isNaN(n) && n > max) max = n;
        });
        const next = max + 1;
        await counterRef.set({ count: next }, { merge: true });
        return prefix + String(next).padStart(4, '0');
    } catch (e2) {
        return prefix + Date.now().toString().slice(-6);
    }
}

function nextOrderNumber() { return nextSequentialNumber('SP-', 'ordersSP'); }

let currentDeliveredFileUrl = '';

async function openOrderModal(id = null) {
    document.getElementById('order-modal').classList.add('active');
    document.getElementById('order-modal-title').textContent = id ? 'تعديل الطلب' : 'إنشاء طلب جديد';
    document.getElementById('order-form').reset();
    document.getElementById('order-id').value = '';
    document.getElementById('order-number').value = '';
    document.getElementById('order-delivery-link').value = '';
    document.getElementById('order-payment-link').value = '';
    document.getElementById('order-payment-link-current').textContent = '';
    currentDeliveredFileUrl = '';
    clearServiceRows('order');

    if (id) {
        const o = orders.find(x => x.id === id);
        if (o) {
            document.getElementById('order-id').value = o.id;
            document.getElementById('order-number').value = o.number || '';
            document.getElementById('order-name').value = o.name || '';
            document.getElementById('order-phone').value = o.phone || '';
            document.getElementById('order-email').value = o.email || '';
            document.getElementById('order-payment').value = o.payment || '';
            document.getElementById('order-payment-detail').value = o.paymentDetail || '';
            togglePaymentDetailField();
            document.getElementById('order-level').value = o.level || '';
            document.getElementById('order-university').value = o.university || '';
            document.getElementById('order-description').value = o.description || '';
            document.getElementById('order-status').value = o.status || 'waiting';

            currentDeliveredFileUrl = o.deliveredFileUrl || '';
            document.getElementById('order-delivery-link').value = currentDeliveredFileUrl;
            const deliveryCurrent = document.getElementById('order-delivery-current');
            deliveryCurrent.innerHTML = currentDeliveredFileUrl
                ? `📎 <a href="${currentDeliveredFileUrl}" target="_blank" rel="noopener">فتح اللينك الحالي</a>`
                : 'لسه معملش حط لينك';

            const currentPaymentLink = o.paymentLink || '';
            document.getElementById('order-payment-link').value = currentPaymentLink;
            document.getElementById('order-payment-link-current').innerHTML = currentPaymentLink
                ? `📎 <a href="${currentPaymentLink}" target="_blank" rel="noopener">فتح لينك الدفع الحالي</a>`
                : 'لسه معملش حط لينك دفع';

            if (Array.isArray(o.items) && o.items.length) {
                o.items.forEach(it => addServiceRow('order', it));
            } else {
                // Old-format order with a single service/price — migrate into one row
                addServiceRow('order', { service: o.service || '', price: o.price || 0, qty: 1, promo: '', discount: 0 });
            }
        }
    } else {
        document.getElementById('order-status').value = 'waiting';
        document.getElementById('order-delivery-current').textContent = '';
        togglePaymentDetailField();
        addServiceRow('order');
        document.getElementById('order-number').value = await nextOrderNumber();
    }
}


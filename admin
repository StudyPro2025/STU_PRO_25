function statusStamp(status, type) {
    return `<span class="stamp stamp-${status}">${STATUS_LABELS[type][status] || status}</span>`;
}

// Inline-editable status dropdown for the invoices table — changes save
// straight to Firestore on selection, no need to open the edit modal.
function invoiceStatusSelect(inv) {
    const labels = STATUS_LABELS.invoice;
    const options = Object.keys(labels).map(val =>
        `<option value="${val}" ${inv.status === val ? 'selected' : ''}>${labels[val]}</option>`
    ).join('');
    return `<select class="stamp stamp-select stamp-${inv.status}" onchange="updateInvoiceStatusInline('${inv.id}', this)">${options}</select>`;
}

function updateInvoiceStatusInline(id, selectEl) {
    const inv = invoices.find(x => x.id === id);
    const newStatus = selectEl.value;
    selectEl.disabled = true;
    db.collection('invoices').doc(id).update({ status: newStatus })
        .then(() => syncInvoiceToOrder(inv, { status: newStatus }))
        .then(() => {
            selectEl.className = 'stamp stamp-select stamp-' + newStatus;
            showToast('تم تحديث حالة الفاتورة', 'success');
        })
        .catch(() => showToast('حدث خطأ أثناء تحديث الحالة', 'error'))
        .finally(() => { selectEl.disabled = false; });
}

// Inline-editable status dropdown for order cards — same idea as invoiceStatusSelect,
// so the status can be changed straight from the orders list without opening the edit modal.
const ORDER_STATUS_OPTIONS = ['waiting', 'accepted', 'in_progress', 'completed', 'rejected'];

function orderStatusSelect(o) {
    const labels = STATUS_LABELS.order;
    const options = ORDER_STATUS_OPTIONS.map(val =>
        `<option value="${val}" ${o.status === val ? 'selected' : ''}>${labels[val]}</option>`
    ).join('');
    return `<select class="stamp stamp-select stamp-${o.status}" onchange="updateOrderStatusInline('${o.id}', this)">${options}</select>`;
}

function updateOrderStatusInline(id, selectEl) {
    const o = orders.find(x => x.id === id);
    if (!o) return;
    const newStatus = selectEl.value;
    if (newStatus === o.status) return;

    // "accepted" isn't a plain status flip — it converts the order into an invoice
    // (see acceptOrder), so route it through the same logic instead of just writing
    // the field. Same for "rejected", which asks for confirmation first.
    if (newStatus === 'accepted') { selectEl.value = o.status; acceptOrder(id); return; }
    if (newStatus === 'rejected') { selectEl.value = o.status; rejectOrder(id); return; }

    selectEl.disabled = true;
    db.collection('orders').doc(id).update({ status: newStatus })
        .then(() => syncOrderToInvoice(o, { status: newStatus }))
        .then(() => {
            selectEl.className = 'stamp stamp-select stamp-' + newStatus;
            showToast('تم تحديث حالة الطلب', 'success');
        })
        .catch(() => showToast('حدث خطأ أثناء تحديث الحالة', 'error'))
        .finally(() => { selectEl.disabled = false; });
}

function emptyState(icon, text) {

}

function escapeHtml(str) {
    if (str === undefined || str === null) return '';
    return String(str).replace(/[&<>"']/g, m => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
}

// =============================================================
// Trash (soft delete) — invoices & orders
// -------------------------------------------------------------
// Deleting an invoice/order no longer removes it permanently: it's moved
// into the 'trash' collection first (full copy of its data + originalId +
// type), then removed from its live collection. From the trash page it can
// be restored (re-written to its original collection under the same id)
// or deleted forever.
// =============================================================
function moveToTrash(type, id, data) {
    return db.collection('trash').add({
        type,
        originalId: id,
        data,
        deletedAt: firebase.firestore.FieldValue.serverTimestamp()
    });
}

function refreshTrash() {
    setText('trash-count', trash.length);
    renderTrashTable(applyTrashFilters());
}

function applyTrashFilters() {
    const type = document.getElementById('trash-type-filter')?.value || 'all';
    return trash.filter(t => type === 'all' || t.type === type);
}

function filterTrash() { renderTrashTable(applyTrashFilters()); }

function fmtTrashDate(ts) {
    if (!ts || !ts.toDate) return '—';
    const d = ts.toDate();
    return d.toLocaleDateString('ar-EG') + ' ' + d.toLocaleTimeString('ar-EG', { hour: '2-digit', minute: '2-digit' });
}

function renderTrashTable(data) {
    const tbody = document.getElementById('trash-tbody');
    if (!tbody) return;
    if (!data.length) {
        tbody.innerHTML = `<tr><td colspan="6">${emptyState('🗑️', 'سلة المهملات فارغة')}</td></tr>`;
        return;
    }
    tbody.innerHTML = data.map(t => {
        const isInvoice = t.type === 'invoice';
        const label = isInvoice ? 'فاتورة' : 'طلب';
        const icon = isInvoice ? '📄' : '🗂️';
        const number = escapeHtml((t.data && t.data.number) || '—');
        const name = escapeHtml((t.data && t.data.name) || '—');
        const amount = t.data && t.data.amount ? '$' + Number(t.data.amount).toLocaleString() : '—';
        return `
        <tr>
            <td>${icon} ${label}</td>
            <td class="mono">${number}</td>
            <td>${name}</td>
            <td class="mono">${amount}</td>
            <td>${fmtTrashDate(t.deletedAt)}</td>
            <td>
                <div class="action-btns">
                    <button class="action-btn view" onclick="restoreFromTrash('${t.id}')" title="استرجاع">↩️</button>
                    <button class="action-btn delete" onclick="permanentDeleteTrash('${t.id}')" title="حذف نهائي">🗑️</button>
                </div>
            </td>
        </tr>`;
    }).join('');
}

function restoreFromTrash(trashId) {
    const item = trash.find(t => t.id === trashId);
    if (!item) { showToast('تعذر العثور على العنصر', 'error'); return; }
    const collectionName = item.type === 'invoice' ? 'invoices' : 'orders';
    db.collection(collectionName).doc(item.originalId).set(item.data)
        .then(() => db.collection('trash').doc(trashId).delete())
        .then(() => showToast('تم استرجاع ' + (item.type === 'invoice' ? 'الفاتورة' : 'الطلب') + ' بنجاح', 'success'))
        .catch(() => showToast('حدث خطأ أثناء الاسترجاع', 'error'));
}

function permanentDeleteTrash(trashId) {
    if (!confirm('هل أنت متأكد من الحذف النهائي؟ لا يمكن التراجع عن هذا الإجراء.')) return;
    db.collection('trash').doc(trashId).delete()
        .then(() => showToast('تم الحذف النهائي', 'success'))
        .catch(() => showToast('حدث خطأ أثناء الحذف', 'error'));
}

function emptyTrash() {
    if (!trash.length) { showToast('سلة المهملات فارغة بالفعل', 'success'); return; }
    if (!confirm(`هل أنت متأكد من إفراغ سلة المهملات بالكامل؟ (${trash.length} عنصر) — لا يمكن التراجع عن هذا الإجراء.`)) return;
    const batch = db.batch();
    trash.forEach(t => batch.delete(db.collection('trash').doc(t.id)));
    batch.commit()
        .then(() => showToast('تم إفراغ سلة المهملات', 'success'))
        .catch(() => showToast('حدث خطأ أثناء الإفراغ', 'error'));
}


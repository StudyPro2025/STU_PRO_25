document.getElementById('order-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const id = document.getElementById('order-id').value;
    const items = getServiceItems('order');
    if (!items.length) { showToast('أضف خدمة واحدة على الأقل', 'error'); return; }
    const subtotal = items.reduce((s, it) => s + it.price * it.qty, 0);
    const discountTotal = items.reduce((s, it) => s + it.discount, 0);
    const total = Math.max(0, subtotal - discountTotal);

    const submitBtn = e.target.querySelector('button[type="submit"]');
    const originalBtnText = submitBtn.textContent;

    const deliveredFileUrl = document.getElementById('order-delivery-link').value.trim();
    const paymentLink = document.getElementById('order-payment-link').value.trim();
    const orderNumber = document.getElementById('order-number').value.trim();
    if (!orderNumber) { showToast('من فضلك أدخل رقم الطلب', 'error'); return; }
    const duplicateOrder = orders.find(o => o.id !== id && (o.number || '').trim() === orderNumber);
    if (duplicateOrder) { showToast('رقم الطلب ده مستخدم بالفعل في طلب تاني (' + duplicateOrder.name + ')', 'error'); return; }

    const data = {
        number: orderNumber,
        name: document.getElementById('order-name').value.trim(),
        phone: document.getElementById('order-phone').value.trim(),
        email: document.getElementById('order-email').value.trim(),
        payment: document.getElementById('order-payment').value,
        paymentDetail: document.getElementById('order-payment-detail-row').style.display !== 'none'
            ? document.getElementById('order-payment-detail').value.trim() : '',
        paymentDetailLabel: document.getElementById('order-payment-detail-label').textContent,
        level: document.getElementById('order-level').value.trim(),
        university: document.getElementById('order-university').value.trim(),
        items: items,
        service: items.map(it => it.service).filter(Boolean).join('، '),
        subtotal: subtotal,
        discountTotal: discountTotal,
        description: document.getElementById('order-description').value.trim(),
        price: total,
        status: document.getElementById('order-status').value,
        deliveredFileUrl: deliveredFileUrl,
        paymentLink: paymentLink,
        created: id ? orders.find(o => o.id === id).created : new Date().toISOString()
    };

    const savePromise = id
        ? db.collection('orders').doc(id).update(data)
        : db.collection('orders').add(data);

    savePromise
        .then(() => {
            if (id) {
                // Editing an already-linked order — push the shared fields (status,
                // payment method/link, delivery link) onto its invoice too.
                const o = orders.find(x => x.id === id);
                return syncOrderToInvoice(o, {
                    status: data.status,
                    deliveredFileUrl: data.deliveredFileUrl,
                    paymentLink: data.paymentLink,
                    payment: data.payment
                });
            }
        })
        .then(() => { closeModal('order-modal'); showToast(id ? 'تم تحديث الطلب' : 'تم إنشاء الطلب (بانتظار القبول)', 'success'); })
        .catch(() => showToast('حدث خطأ أثناء الحفظ', 'error'))
        .finally(() => { submitBtn.disabled = false; submitBtn.textContent = originalBtnText; });
});

